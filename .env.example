# Copy to .env (or set as real environment variables / server config) and fill in
# real values below.
# IMPORTANT: leave unfilled keys commented out (not blank "KEY=") - a
# present-but-empty value overrides application.properties' placeholder
# default and breaks startup, where a genuinely absent/commented key falls
# back to the default fine.

# Gmail SMTP, used only to send registration email verification links.
# MAIL_APP_PASSWORD is a Google Account "App Password" (Google Account ->
# Security -> 2-Step Verification -> App Passwords, entered with NO SPACES),
# NOT the account's normal login password.
#MAIL_USERNAME=
#MAIL_APP_PASSWORD=

# Public base URL the app is reachable at, used to build the link inside
# verification emails. Change this to the real domain/IP once deployed.
APP_BASE_URL=http://localhost:8084

# ONLYOFFICE Document Server (Office document preview - see docker-compose.yml
# and OnlyOfficeService). ONLYOFFICE_URL is what the user's BROWSER loads the
# viewer script from; ONLYOFFICE_JWT_SECRET must be the exact same secret
# configured on the Document Server itself (JWT_SECRET in docker-compose.yml)
# - generate a long random value for real deployments, e.g.:
#   openssl rand -base64 48
# JWT is required (not optional) whenever ONLYOFFICE is reachable from
# anywhere other than your own machine - without it, anyone who can reach
# the Document Server's URL can ask it to fetch and render any document URL
# you give it, with no proof the request actually came from this app.
# ONLYOFFICE Document Server (Office document preview - see docker-compose.yml).
# Generated with: openssl rand -base64 48
ONLYOFFICE_URL=http://localhost:8085
ONLYOFFICE_JWT_ENABLED=true
ONLYOFFICE_JWT_SECRET=ov5MmfPqCk5oAN7vOTVBnvpQcPX6X23jjfbuiPIFismYLl0BR1LjbxTQxevdcUWM
# host.docker.internal, not the LAN IP above - this is what the ONLYOFFICE
# CONTAINER uses to reach the app to fetch file bytes, a different network
# path than what a browser uses (see .env.example's explanation). Docker's
# host-gateway mapping (docker-compose.yml's extra_hosts) resolves this to
# your machine regardless of its real IP.
ONLYOFFICE_APP_BASE_URL=http://host.docker.internal:8084
